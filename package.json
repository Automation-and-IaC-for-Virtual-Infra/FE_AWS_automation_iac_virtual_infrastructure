    "clsx": "^2.1.1",
    "cx": "^25.9.0",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "jwk-to-pem": "^2.0.7",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.64.0",
